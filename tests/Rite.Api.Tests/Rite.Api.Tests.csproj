<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rite.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rite.Api\Rite.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory<Program> runs the real app, whose content
         seeding looks next to the running assembly (AppContext.BaseDirectory),
         which is this test project's own output directory at test time. -->
    <Content Include="..\..\docs\content\timeline.json" Link="content\timeline.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\stories.json" Link="content\stories.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\alumni.json" Link="content\alumni.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\resources.json" Link="content\resources.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\faq.json" Link="content\faq.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\impact.json" Link="content\impact.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\program-cycle.json" Link="content\program-cycle.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
