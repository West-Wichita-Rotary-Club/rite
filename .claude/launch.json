{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rite-docs-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "docs"],
      "port": 8080
    },
    {
      "name": "rite-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "src/Rite.Web", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "rite-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Rite.Api", "--configuration", "Debug", "--urls", "http://localhost:5159"],
      "port": 5159
    }
  ]
}
