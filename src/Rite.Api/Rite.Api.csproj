<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Rite.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Pin past the transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11 pulled in by
         EF Core 10.0.0's Sqlite provider (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seeded from the repository's own bilingual content model (single source of
         truth shared with the static docs/ preview), not a duplicated copy. -->
    <Content Include="..\..\docs\content\timeline.json" Link="content\timeline.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\stories.json" Link="content\stories.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\alumni.json" Link="content\alumni.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\resources.json" Link="content\resources.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\faq.json" Link="content\faq.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\impact.json" Link="content\impact.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\content\program-cycle.json" Link="content\program-cycle.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
