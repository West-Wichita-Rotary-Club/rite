<Project>
  <!--
    ps-008: a one-click target for Visual Studio's Publish dialog. Produces a
    framework-dependent folder publish (the VM needs the ASP.NET Core Hosting
    Bundle installed) plus rite-api-publish.zip next to it (see Rite.Api.csproj's
    ZipRitePublishOutput target) — copy that zip to the VM and extract it.
  -->
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <PublishDir>bin\Release\net10.0\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
